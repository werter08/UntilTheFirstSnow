    condition: 0
    style: 2
    speaker: Mira
    text: "Hi\u2026 I'm Mira, from across. I ran out of coffee. Could I borrow some?"
    setsMiraWindow: 0
    miraWindowAfter: 0
  - trigger: 1
    stepIndex: 4
    condition: 0
    style: 2
    speaker: Mira
    text: "Something sweet\u2026 with cinnamon? Surprise me."
    setsMiraWindow: 0
    miraWindowAfter: 0
  - trigger: 2
    stepIndex: 0
    condition: 1
    style: 2
    speaker: Mira
    text: Okay. That's the best cup I've had this month.
    setsMiraWindow: 0
    miraWindowAfter: 0
  - trigger: 2
    stepIndex: 0
    condition: 2
    style: 2
    speaker: Mira
    text: "It's\u2026 nice. Thank you."
    setsMiraWindow: 0
    miraWindowAfter: 0
  - trigger: 2
    stepIndex: 0
    condition: 0
    style: 0
    speaker: 
    text: I think I'm smiling. Weird feeling.
